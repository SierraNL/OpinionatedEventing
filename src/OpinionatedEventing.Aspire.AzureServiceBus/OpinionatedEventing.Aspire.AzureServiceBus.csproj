<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Aspire AppHost extension for OpinionatedEventing — adds an Azure Service Bus emulator resource. Reference this package from your AppHost project only.</Description>
    <PackageTags>$(PackageTags) aspire azure azure-service-bus local-dev</PackageTags>
    <!-- Aspire.Hosting 13 requires Microsoft.Extensions 10.x on every TFM, so skip the net8.0 floor. -->
    <UseLatestExtensions>true</UseLatestExtensions>
  </PropertyGroup>

  <!-- Force MessagePack 2.5.303, pulled in transitively via Aspire.Hosting (GHSA-qhrr-8q5h-9q3h). -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
    <PackageReference Include="MessagePack" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry" VersionOverride="1.20.1" />
  </ItemGroup>

</Project>
