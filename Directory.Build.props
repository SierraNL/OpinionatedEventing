<Project>

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- MTP / xunit.v3: test projects run as self-executing assemblies and are driven by
       native MTP via the global.json test runner setting (SDK 10+). -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <!-- NuGet package metadata (applies to src/ only) -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' and '$(IsSampleProject)' != 'true'">
    <Authors>Leon Grave</Authors>
    <Company>SierraNL</Company>
    <Product>OpinionatedEventing</Product>
    <PackageProjectUrl>https://opinionated-eventing.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SierraNL/OpinionatedEventing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-128.png</PackageIcon>
    <PackageTags>messaging eventing dotnet dotnet-library</PackageTags>
    <!-- MinVer: tags are "v1.2.3"; post-RTM commits get "{major}.{minor}.{patch+1}-preview.0.{height}". -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true' and '$(IsSampleProject)' != 'true'">
    <None Include="README.md" Pack="true" PackagePath="\"/>
    <None Include="$(MSBuildThisFileDirectory)assets/logo-128.png" Pack="true" PackagePath="\"/>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

</Project>
